# Copy to .env for local dev. In production (Railway), set these directly
# in the service's environment variables instead of a checked-in file.

# Required
DATABASE_URL=postgres://you@localhost:5432/konfirm_dev
JWT_SECRET=                     # generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
ADMIN_JWT_SECRET=                # generate the same way — must be a DIFFERENT value from JWT_SECRET

# Recommended in production, optional locally
NODE_ENV=development             # set to "production" for JSON logs + correct Sentry environment tag
SENTRY_DSN=                      # no-op (logged warning) if unset

# Platform-injected — leave unset locally, Railway sets this automatically
PORT=

# Testnet faucet (/deposits/*: fund any address with test USDC/XLM). Off unless
# exactly "true". Set it locally for /get-test-usdc; never in production.
ENABLE_TESTNET_FAUCET=

# On-chain compliance check (src/payments/payments.service.ts, reconciler/src/compliance.rs)
# Locally: unset — falls back to the pre-registered `deployer` stellar CLI identity.
# In production: required — no interactive `stellar keys add` step is possible in a
# container, so the raw secret key is passed directly via this env var instead.
STELLAR_DEPLOYER_SECRET_KEY=

# Backups (db/scripts/backup.sh) — off-machine upload is skipped with a
# warning if unset, so none of these are required for local dev.
BACKUP_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Reconciler only (reconciler/Dockerfile) — which merchant address to watch,
# and the outer polling bound/cadence. See "The reconciler watches one
# merchant address per process" in Known limitations.
MERCHANT_STELLAR_ADDRESS=
RECONCILER_MAX_POLLS=999999
RECONCILER_INTERVAL_SECS=3

# Network. testnet is the default. mainnet is refused at boot until the
# testnet-only config is replaced (see src/common/stellar-network.ts).
STELLAR_NETWORK=testnet
# Optional overrides of the preset endpoints (for example a private RPC).
HORIZON_URL=
SOROBAN_RPC_URL=

# Hot keys: see docs/KEYS.md. Production needs the facilitator set via KMS or
# its own secret, never the deployer key.
FACILITATOR_KMS_KEY_ID=
FACILITATOR_SECRET_KEY=
PLATFORM_FEE_SECRET_KEY=

# Session and proxy settings (see README: Auth and Deployment)
APP_URL=http://localhost:3000
TRUST_PROXY_HOPS=
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_TOKEN=
# Without MAIL_WEBHOOK_URL, mail bodies (reset links) are logged only when NODE_ENV=development
# or this is exactly "true". Never enable it where others can read the logs.
MAIL_LOG_FALLBACK=

